# Everything shared between the agent sandboxes (full toolset, hardened
# sshd, docker client) lives in mwaeckerlin/sandbox-base — this image only
# adds the openclaw skills and its entrypoint.
FROM mwaeckerlin/openclaw-mcp-gateway AS mcp_gateway_skills
FROM mwaeckerlin/mcp-github AS mcp_github_skills

FROM mwaeckerlin/sandbox-base AS build
ENV CONTAINERNAME="openclaw"
ADD https://github.com/mwaeckerlin/ai-agent-skills.git#master:skills /app/skills/
COPY --from=mcp_gateway_skills /app/skills/openclaw-mcp-gateway /app/skills/
COPY --from=mcp_github_skills /app/skills/mcp-github /app/skills/
ADD files/sandbox-entrypoint.sh /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

FROM build
